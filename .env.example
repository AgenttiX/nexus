# Copy to .env and fill in. Never commit .env: this repository is public.
# Generate secrets with e.g. `openssl rand -base64 48`.

# Public hostnames, as configured in nginx/nexus-servers.conf
NEXUS_HOST=nexus.example.com
AUTHENTIK_HOST=auth.example.com

# Address on which the containers publish their ports for the external Nginx.
# Use the Docker host's LAN address once Nginx runs on another machine.
BIND_ADDRESS=127.0.0.1
# Published ports. Keep them in step with the upstreams in nginx/nexus-servers.conf.
WEB_PORT=8000
MCP_PORT=8001
AUTHENTIK_PORT=9000

# Decides what "today" means, for example for menus and sleep statistics
TIME_ZONE=Europe/Helsinki

# Container image tags
NEXUS_IMAGE=ghcr.io/agenttix/nexus:latest
AUTHENTIK_TAG=2026.8.5

# Django
DJANGO_SECRET_KEY=
# Secrets in the database (such as calendar addresses) are encrypted with a key derived from
# DJANGO_SECRET_KEY and this salt. Keep both: without them that data cannot be read.
# To change the secret key later, list the old one in DJANGO_SECRET_KEY_FALLBACKS.
FIELD_ENCRYPTION_SALT=
DJANGO_SECRET_KEY_FALLBACKS=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# OIDC client that Django uses against Authentik. The same values are read by
# the Authentik blueprint, so the two sides always agree.
OIDC_CLIENT_ID=nexus
OIDC_CLIENT_SECRET=

# Language models, through the OpenAI-compatible API of a LiteLLM proxy.
# Leave empty to run without the features that need a language model (news digests).
LITELLM_BASE_URL=https://litellm.example.com/v1
LITELLM_API_KEY=
# Model name, as LiteLLM knows it, for users who have not chosen their own
LLM_DEFAULT_MODEL=
# Articles summarised at the same time in the parallel digest mode
NEWS_PARALLEL_SESSIONS=4

# Optional free demo key from https://www.coingecko.com/en/api, which raises the rate limit
# for cryptocurrency prices. Prices are fetched without it too.
COINGECKO_API_KEY=

# Authentik
AUTHENTIK_SECRET_KEY=
AUTHENTIK_POSTGRES_PASSWORD=

# Host directory with ActivityWatch data, mounted read-only into the worker. It must hold one
# subdirectory per user, named after the username, into which that user's devices synchronise
# their databases (for example with aw-sync and Syncthing).
AW_SYNC_DIR=./data/activitywatch
